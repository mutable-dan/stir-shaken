<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.shawanga.stir_shaken">

    <!-- For Pop-ups -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- For Notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="STIR/SHAKEN Notifier"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight">

        <activity android:name="com.shawanga.stir_shaken.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Change .SettingsActivity to this: -->
        <activity android:name="com.shawanga.stir_shaken.SettingsActivity" android:exported="false" />

        <!-- The background service that detects incoming calls -->
        <service
            android:name="com.shawanga.stir_shaken.StirShakenService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

